# Copie este arquivo como .env. Nunca publique o .env real.
FAEHUB_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Use a connection string "Session pooler" exibida em Connect > ORMs > Python
# no painel do Supabase. Troque os campos entre <...> pelos valores do projeto.
FAEHUB_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres
FAEHUB_DB_SSLMODE=require
FAEHUB_DB_POOL_SIZE=5

# Convites por e-mail: configurar somente no ambiente do servidor.
# Render Free bloqueia SMTP; esta integração usa a API HTTPS do Resend.
# O remetente precisa estar autorizado/verificado no serviço.
FAEHUB_PUBLIC_URL=https://faehub-plus.onrender.com
FAEHUB_MAIL_FROM=
FAEHUB_RESEND_API_KEY=
# Gmail API: altere o provider somente após autorizar a caixa institucional.
FAEHUB_MAIL_PROVIDER=resend
FAEHUB_GMAIL_SENDER=faetech.sc@gmail.com
FAEHUB_GMAIL_CLIENT_ID=
FAEHUB_GMAIL_CLIENT_SECRET=
FAEHUB_GMAIL_REFRESH_TOKEN=
# E-mail legítimo do primeiro diretor, definido somente pelo dono do servidor.
# A conta demo só pode migrar a si própria para este endereço.
FAEHUB_BOOTSTRAP_ADMIN_EMAIL=

# Autenticador: chave Fernet privada e estável, diferente da chave de sessão.
# Guardar cópia segura fora do banco; não trocar após ativar contas sem migração.
FAEHUB_MFA_ENCRYPTION_KEY=

# Backup privado: conexão direta/Session pooler, nunca Transaction pooler.
# O operador pode usar as mesmas dependências, mas precisa dos clientes PG 17+.
FAEHUB_BACKUP_DATABASE_URL=
FAEHUB_BACKUP_KEY=
FAEHUB_RESTORE_DATABASE_URL=
FAEHUB_DRIVE_CLIENT_ID=
FAEHUB_DRIVE_CLIENT_SECRET=
FAEHUB_DRIVE_REFRESH_TOKEN=
FAEHUB_DRIVE_FOLDER_ID=
